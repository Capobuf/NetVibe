# Copy to .env for local development. The .env file is gitignored.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=*
DJANGO_TIME_ZONE=Europe/Rome
TZ=Europe/Rome
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
DATABASE_HOST=db
DATABASE_PORT=5432
# Required by ipam/crypto.py for MikroTik credential encryption.
NETVIBE_PGCRYPTO_KEY=change-me-to-a-real-secret
