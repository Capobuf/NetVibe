SERVER_URL=http://ipam:9693
AGENT_API_TOKEN=
LOG_LEVEL=info
AGENT_POLL_INTERVAL_SECONDS=5
AGENT_CONFIG_REFRESH_SECONDS=60

# TLS verification when calling the NetVibe server (recommended true in production)
NETVIBE_TLS_VERIFY=true
# Optional: custom CA bundle path inside the container (used when NETVIBE_TLS_VERIFY=true)
NETVIBE_TLS_CA_BUNDLE=

# TLS verification when calling MikroTik REST API (many deployments use self-signed certs)
# If you enable this, consider setting a CA bundle or using trusted certs on devices.
MIKROTIK_TLS_VERIFY=false
MIKROTIK_TLS_CA_BUNDLE=

