# PRODUCTION SAMPLE ENV (do NOT commit secrets) — copy to .env.production and set secure values
APP_NAME="NetVibe"
APP_ENV=production
APP_KEY=base64:your_base64_key_here
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://your-domain.example

# DATABASE
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=modern_ipam
DB_USERNAME=ipam_user
DB_PASSWORD=replace-with-secure-password

# REDIS
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Optional - override worker command in production if needed
# WORKER_CMD="php artisan queue:work --sleep=3 --tries=3 --timeout=0"
