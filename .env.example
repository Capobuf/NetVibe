#
# =========================================================================
# MODERN IPAM - ENVIRONMENT VARIABLES
# =========================================================================
#

# -------------------------------------------------------------------------
# 1. APPLICATION
# -------------------------------------------------------------------------

APP_NAME="Modern IPAM"
APP_ENV=local
APP_KEY=base64:your_base64_key_here
APP_DEBUG=true
APP_TIMEZONE=UTC
# Must match the exposed port in docker/dev/docker-compose.override.yml
APP_URL=http://localhost:9693

# -------------------------------------------------------------------------
# 2. DATABASE (MARIADB)
# -------------------------------------------------------------------------

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=modern_ipam
DB_USERNAME=ipam_user
DB_PASSWORD=secret

# -------------------------------------------------------------------------
# 3. CACHE & QUEUE (REDIS)
# -------------------------------------------------------------------------

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis