# =============================================================================
# NETVIBE CONFIGURATION (V2.0)
# =============================================================================
# Copy this file to .env and customize for your environment.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION IDENTITY & CONTEXT
# -----------------------------------------------------------------------------

# The name of the application (displayed in UI and Emails).
APP_NAME="NetVibe"

# The environment context.
# 'local'      = Development (Enables debug tools, verbose errors).
# 'production' = Live (Optimized for speed, secure, hidden errors).
# Note: Laravel uses 'local' internally for dev mode, avoiding 'dev' prevents conflicts.
APP_ENV=local

# The encryption key for sessions and data.
# CRITICAL: Must be 32 random characters base64 encoded.
# Linux/Mac:  Run `openssl rand -base64 32` or `php artisan key:generate --show`
# Windows:    Run `php artisan key:generate --show` in terminal.
APP_KEY=

# Enable detailed error stack traces in browser.
# Set to 'false' in production to prevent sensitive data leaks.
APP_DEBUG=true

# The public base URL of the application.
# Do not include trailing slash.
APP_URL=https://ipam.example.com

# -----------------------------------------------------------------------------
# 2. REGION & LOCALIZATION
# -----------------------------------------------------------------------------

# Unified Timezone for Application and Database Containers.
# List of supported timezones: https://www.php.net/manual/en/timezones.php
TZ=Europe/Rome

# Default language for the UI (e.g., 'en', 'it', 'fr').
APP_LOCALE=en

# Fallback language if the selected translation is missing.
APP_FALLBACK_LOCALE=en

# Locale used by Faker to generate demo data (e.g., names, addresses).
APP_FAKER_LOCALE=en_US

# -----------------------------------------------------------------------------
# 3. SERVER & INFRASTRUCTURE
# -----------------------------------------------------------------------------

# Application Server Driver.
# NetVibe runs on FrankenPHP via Laravel Octane.
# This tells Laravel how to handle requests (keep 'frankenphp').
OCTANE_SERVER=frankenphp

# Trusted Proxies Configuration.
# '*' trusts all proxies (Standard for Docker behind Nginx Proxy Manager/Traefik).
# Fixes HTTPS redirects and URL generation issues.
TRUSTED_PROXIES=*

# Maintenance Mode Driver.
# 'file' is the standard driver (uses a temp file to block access during updates).
APP_MAINTENANCE_DRIVER=file

# -----------------------------------------------------------------------------
# 4. DATABASE (MARIADB)
# -----------------------------------------------------------------------------

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=netvibe
DB_USERNAME=netvibe_user
DB_PASSWORD=secret

# -----------------------------------------------------------------------------
# 5. CACHE & QUEUE (REDIS)
# -----------------------------------------------------------------------------
# Redis is mandatory for NetVibe performance (Queues, Caching, Sessions).

REDIS_HOST=netvibe-redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Internal drivers forced to Redis (Best Practice for performance)
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# -----------------------------------------------------------------------------
# 6. LOGGING & MONITORING
# -----------------------------------------------------------------------------

# Where logs are sent.
# 'stack' = Can combine multiple channels.
# 'stderr' = Writes to Docker Console (Best for container monitoring).
LOG_CHANNEL=stack

# Minimum severity level to log.
# Options (Low to High):
# - debug     : Detailed debug info (Dev only)
# - info      : Interesting events (e.g. User logs in)
# - warning   : Exceptional occurrences that are not errors
# - error     : Runtime errors that do not require immediate action
# - critical  : Critical conditions (Component unavailable)
# - alert     : Action must be taken immediately
# - emergency : System is unusable
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# 7. MAIL CONFIGURATION
# -----------------------------------------------------------------------------
# Used for password resets, alerts, and system notifications.

# Driver: 'smtp', 'log' (for dev), 'sendmail'.
MAIL_MAILER=log

# SMTP Server Details
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null

# Encryption Protocol
# Options: 'tls' (STARTTLS), 'ssl' (Implicit SSL), or null (No encryption).
MAIL_ENCRYPTION=null

# Sender Identity
MAIL_FROM_ADDRESS="no-reply@netvibe.local"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# 8. FRONTEND ASSETS
# -----------------------------------------------------------------------------
# Passes the Application Name to the frontend build (Vite/JS).
# Required to display the correct title in the browser tab.
VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# 9. SESSION CONFIGURATION
# -----------------------------------------------------------------------------

SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
FORCE_CANONICAL_URL=false

# -----------------------------------------------------------------------------
# DOCKER USER MAPPING (UID / GID)
# -----------------------------------------------------------------------------
WWWUSER=1000
WWWGROUP=1000