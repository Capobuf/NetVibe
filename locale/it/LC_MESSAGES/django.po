#: ipam/models.py:20
msgid "Number"
msgstr "Numero"

#: ipam/models.py:21
msgid "Enter a VLAN ID between 1 and 4094."
msgstr "Inserisci un ID VLAN tra 1 e 4094."

#: ipam/models.py:27
msgid "Add an optional display name for this VLAN."
msgstr "Aggiungi un nome visualizzato facoltativo per questa VLAN."

#: ipam/models.py:44
msgid "Sequential"
msgstr "Sequenziale"

#: ipam/models.py:45
msgid "Parallel"
msgstr "Parallelo"

#: ipam/models.py:58
msgid "Warning after (minutes)"
msgstr "Avviso dopo (minuti)"

#: ipam/models.py:59
msgid "Mark an IP as stale after this many minutes without a response."
msgstr "Segna un IP come non aggiornato dopo questo numero di minuti senza risposta."

#: ipam/models.py:64
msgid "Offline after (minutes)"
msgstr "Offline dopo (minuti)"

#: ipam/models.py:65
msgid "Mark an IP as offline after this many minutes without a response."
msgstr "Segna un IP come offline dopo questo numero di minuti senza risposta."

#: ipam/models.py:70
msgid "Default scan interval (minutes)"
msgstr "Intervallo di scansione predefinito (minuti)"

#: ipam/models.py:71
msgid "Use this interval when a subnet does not override its scan frequency."
msgstr "Usa questo intervallo quando una sottorete non sovrascrive la propria frequenza di scansione."

#: ipam/models.py:77
msgid "Worker mode"
msgstr "Modalità worker"

#: ipam/models.py:78
msgid "Choose whether the worker runs one scan at a time or multiple scans."
msgstr "Scegli se il worker esegue una scansione alla volta o più scansioni."

#: ipam/models.py:83
msgid "Worker concurrency"
msgstr "Concorrenza worker"

#: ipam/models.py:84
msgid "Use this many worker processes when parallel mode is enabled."
msgstr "Usa questo numero di processi worker quando la modalità parallela è abilitata."

#: ipam/models.py:89
msgid "Ping timeout (ms)"
msgstr "Timeout ping (ms)"

#: ipam/models.py:90
msgid "Wait this many milliseconds for each ICMP response."
msgstr "Attendi questo numero di millisecondi per ogni risposta ICMP."

#: ipam/models.py:95
msgid "Ping concurrency"
msgstr "Concorrenza ping"

#: ipam/models.py:96
msgid "Limit how many ping subprocesses run at once inside one scan job."
msgstr "Limita quanti sottoprocessi di ping vengono eseguiti contemporaneamente in un job di scansione."

#: ipam/models.py:139
msgid "Offline threshold must be greater than the warning threshold."
msgstr "La soglia offline deve essere maggiore della soglia di avviso."

#: ipam/models.py:152
msgid "Select the VLAN associated with this subnet, if any."
msgstr "Seleziona la VLAN associata a questa sottorete, se presente."

#: ipam/models.py:160
msgid "Parent subnet"
msgstr "Sottorete padre"

#: ipam/models.py:161
msgid "Select a parent subnet when this subnet is nested inside another one."
msgstr "Seleziona una sottorete padre quando questa sottorete è annidata in un'altra."

#: ipam/models.py:165
msgid "Subnet (CIDR)"
msgstr "Sottorete (CIDR)"

#: ipam/models.py:166
msgid "Enter an IPv4 subnet in CIDR notation, for example 10.0.0.0/24."
msgstr "Inserisci una sottorete IPv4 in notazione CIDR, ad esempio 10.0.0.0/24."

#: ipam/models.py:170
msgid "Description"
msgstr "Descrizione"

#: ipam/models.py:171
msgid "Add optional notes about this subnet."
msgstr "Aggiungi note facoltative su questa sottorete."

#: ipam/models.py:176
msgid "Enable ICMP reachability checks for this subnet."
msgstr "Abilita controlli di raggiungibilità ICMP per questa sottorete."

#: ipam/models.py:180
msgid "Discovery enabled"
msgstr "Discovery abilitata"

#: ipam/models.py:181
msgid "Enable discovery tasks for this subnet."
msgstr "Abilita task di discovery per questa sottorete."

#: ipam/models.py:188
msgid "Override the global scan frequency for this subnet. Leave blank to use the global default."
msgstr "Sovrascrivi la frequenza di scansione globale per questa sottorete. Lascia vuoto per usare il predefinito globale."

#: ipam/models.py:194
msgid "Warning after override (minutes)"
msgstr "Sovrascrittura avviso dopo (minuti)"

#: ipam/models.py:195
msgid "Override the global warning threshold for this subnet. Leave blank to use the global default."
msgstr "Sovrascrivi la soglia di avviso globale per questa sottorete. Lascia vuoto per usare il predefinito globale."

#: ipam/models.py:201
msgid "Offline after override (minutes)"
msgstr "Sovrascrittura offline dopo (minuti)"

#: ipam/models.py:202
msgid "Override the global offline threshold for this subnet. Leave blank to use the global default."
msgstr "Sovrascrivi la soglia offline globale per questa sottorete. Lascia vuoto per usare il predefinito globale."

#: ipam/models.py:251
msgid "Enter a valid IPv4 subnet in CIDR notation, for example 10.0.0.0/24."
msgstr "Inserisci una sottorete IPv4 valida in notazione CIDR, ad esempio 10.0.0.0/24."

#: ipam/models.py:262
msgid "A subnet cannot be its own parent."
msgstr "Una sottorete non può essere padre di sé stessa."

#: ipam/models.py:271
msgid "The child subnet must be contained in the parent subnet."
msgstr "La sottorete figlia deve essere contenuta nella sottorete padre."

#: ipam/models.py:284
msgid "Offline override must be greater than the warning override."
msgstr "La sovrascrittura offline deve essere maggiore della sovrascrittura di avviso."

#: ipam/models.py:295
msgid "Scanning requires a valid interval in minutes."
msgstr "La scansione richiede un intervallo valido in minuti."

#: ipam/models.py:304
msgid "The effective offline threshold must be greater than the effective warning threshold."
msgstr "La soglia offline effettiva deve essere maggiore della soglia di avviso effettiva."

